{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["rustup", "plutil", "lipo"],
  "entry": [
    "ui/phone-download.worker.ts",
    "desktop/main.cjs", "desktop/preload.cjs", "public/phone-sw.js",
    "scripts/*.mjs"
  ],
