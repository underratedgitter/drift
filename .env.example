# Build-time settings only; these are not app-login credentials.
# Shell/CI variables are read directly; .env files are not auto-loaded.
# iOS device builds require full Xcode plus your installed signing setup.
DRIFT_IOS_TEAM_ID=
DRIFT_IOS_BUNDLE_ID=dev.yourorganization.drift
DRIFT_IOS_EXPORT_METHOD=debugging
DRIFT_IOS_ALLOW_PROVISIONING=0
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# For runner-provided Android tools; local bootstrap supplies environment.json.
# JAVA_HOME=
# ANDROID_HOME=
# ANDROID_NDK_HOME=
# Never store Apple private keys, provisioning profiles or keystore passwords here.
