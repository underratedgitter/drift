{
  "name": "drift-transfer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "cargo test --manifest-path engine/Cargo.toml",
    "test:ui": "cargo build --manifest-path engine/Cargo.toml && npm run build && playwright test",
    "bench": "node scripts/benchmark.mjs",
    "start": "npm run build && cargo run --manifest-path engine/Cargo.toml -- --ui dist/ui",
    "desktop:dev": "npm run build && cargo build --manifest-path engine/Cargo.toml && electron desktop",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "android:package": "node scripts/build-android.mjs",
    "mac:installer": "npm run build && node scripts/package-desktop.mjs dmg",
    "mac:installer:arm64": "npm run build && node scripts/package-desktop.mjs dmg arm64",
    "windows:installer": "npm run build && node scripts/package-desktop.mjs nsis",
    "windows:cross": "npm run build && node scripts/build-windows-cross.mjs",
    "ios:package": "node scripts/build-ios.mjs",
    "ios:simulator": "node scripts/build-ios.mjs --simulator",
    "audit:unused": "npm exec --yes --package=knip@6.41.0 -- knip --no-progress",
    "test:native": "npm run build && cargo test --manifest-path native/core/Cargo.toml --target-dir engine/target",
    "test:android": "cargo build --manifest-path engine/Cargo.toml && node scripts/test-android-emulator.mjs",
    "test:build-config": "node --test tests/build-config.test.mjs",
    "test:release-tools": "node --test tests/release-tools.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.8.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0"
  },
  "overrides": { "global-agent": "^4.1.3" }
}
