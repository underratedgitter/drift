{
  "name": "drift",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "cargo test --workspace",
    "test:ui": "cargo build -p drift-engine && npm run build && playwright test",
    "test:tools": "node --test tests/release-tools.test.mjs",
    "app:dev": "tauri dev",
    "app:build": "tauri build --target universal-apple-darwin",
    "bench": "node scripts/benchmark.mjs",
    "audit:unused": "npm exec --yes --package=knip@6.41.0 -- knip --no-progress"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7"
  },
  "description": "Send files and folders directly between your Macs",
  "license": "MIT"
}
